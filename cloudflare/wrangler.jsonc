{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cuma-world-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDirectory" },
      { "name": "RATE_LIMITS", "class_name": "RateLimiter" }
    ]
  },
  "exports": {
    "RoomDirectory": { "type": "durable-object", "storage": "sqlite" },
    "RateLimiter": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "PUBLIC_BUILD_CHANNEL": "development",
    "MIN_CLIENT_BUILD": "3.0.0-dev",
    "MAX_ROOM_TTL_SECONDS": "21600",
    "LOOKUP_LIMIT_PER_MINUTE": "24"
  }
}
