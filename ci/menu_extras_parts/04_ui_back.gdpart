	dialog_overlay.add_child(dim)
	var panel = PanelContainer.new()
	panel.anchor_left = 0.10 if _is_portrait() else 0.56
	panel.anchor_right = 0.90 if _is_portrait() else 0.92
	panel.anchor_top = 0.30
	panel.anchor_bottom = 0.70
	panel.add_theme_stylebox_override("panel", _panel_style(PANEL, 10, Color(ACCENT, 0.38)))
	dim.add_child(panel)
	var margin = MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 22)
	margin.add_theme_constant_override("margin_right", 22)
	margin.add_theme_constant_override("margin_top", 20)
	margin.add_theme_constant_override("margin_bottom", 20)
	panel.add_child(margin)
	var box = VBoxContainer.new()
	box.add_theme_constant_override("separation", 10)
	margin.add_child(box)
	box.add_child(_label(title, 26, TEXT))
	var body = _label(message, 12, MUTED)
	body.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	box.add_child(body)
	var yes = _button("ONAYLA", true)
	yes.pressed.connect(_run_confirm_action.bind(action))
	box.add_child(yes)
	var no = _button("VAZGEÇ", false)
	no.pressed.connect(_close_dialog_overlay)
	box.add_child(no)
	no.grab_focus()

func _run_confirm_action(action: Callable) -> void:
	_close_dialog_overlay()
	action.call()

func _close_dialog_overlay() -> void:
	if dialog_overlay != null:
		dialog_overlay.queue_free()
		dialog_overlay = null
	_play_player(back_player, 0.72)

func _show_notice(text: String) -> void:
	if dialog_overlay != null:
		return
	dialog_overlay = CanvasLayer.new()
	dialog_overlay.name = "CumaNotice"
	dialog_overlay.layer = 270
	dialog_overlay.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(dialog_overlay)
	var label = _label(text, 15, TEXT)
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.anchor_left = 0.20
	label.anchor_right = 0.80
	label.anchor_top = 0.08
	label.anchor_bottom = 0.18
	label.add_theme_stylebox_override("normal", _panel_style(PANEL, 8, Color(ACCENT, 0.25)))
	dialog_overlay.add_child(label)
	var timer = get_tree().create_timer(1.5, true, false, true)
	timer.timeout.connect(_close_dialog_overlay)

func _find_box_with_label(root: Node, target: String) -> VBoxContainer:
	if root is VBoxContainer:
		for child in root.get_children():
			if child is Label and child.text == target:
				return root as VBoxContainer
	for child in root.get_children():
		var found = _find_box_with_label(child, target)
		if found != null:
			return found
	return null

func _find_button_with_text(root: Node, target: String) -> Button:
	for child in root.get_children():
		if child is Button and child.text == target:
			return child as Button
		var found = _find_button_with_text(child, target)
		if found != null:
			return found
	return null

func _remove_extra_marker(safe: Control) -> void:
	var old = safe.find_child("CumaExtrasMarker", true, false)
	if old != null:
		old.queue_free()

func _button(text_value: String, primary: bool) -> Button:
	var button = Button.new()
	button.text = text_value
	button.custom_minimum_size = Vector2(220, 50)
	button.alignment = HORIZONTAL_ALIGNMENT_LEFT
	button.add_theme_font_size_override("font_size", 15)
	button.add_theme_color_override("font_color", TEXT)
	var bg = Color(0.09, 0.09, 0.095, 0.90) if primary else Color(0.03, 0.034, 0.041, 0.78)
	var edge = ACCENT if primary else Color(1, 1, 1, 0.16)
	button.add_theme_stylebox_override("normal", _button_style(bg, edge))
	button.add_theme_stylebox_override("hover", _button_style(Color(0.12, 0.12, 0.125, 0.94), ACCENT))
	button.add_theme_stylebox_override("focus", _button_style(Color(0.12, 0.12, 0.125, 0.94), ACCENT))
	button.add_theme_stylebox_override("pressed", _button_style(Color(0.15, 0.15, 0.16, 0.96), ACCENT))
	return button

func _toggle(text_value: String, enabled: bool) -> CheckButton:
	var toggle = CheckButton.new()
	toggle.text = text_value
	toggle.button_pressed = enabled
	toggle.custom_minimum_size.y = 46
	toggle.add_theme_font_size_override("font_size", 13)
	toggle.add_theme_color_override("font_color", TEXT)
	return toggle

func _line_edit(placeholder: String) -> LineEdit:
	var input = LineEdit.new()
	input.placeholder_text = placeholder
	input.custom_minimum_size = Vector2(240, 48)
	input.add_theme_color_override("font_color", TEXT)
	input.add_theme_color_override("font_placeholder_color", Color(MUTED, 0.62))
	input.add_theme_stylebox_override("normal", _panel_style(Color(0.012, 0.015, 0.020, 0.82), 5, Color(1, 1, 1, 0.13)))
	input.add_theme_stylebox_override("focus", _panel_style(Color(0.018, 0.021, 0.026, 0.94), 5, Color(ACCENT, 0.60)))
	return input

func _label(text_value: String, size: int, color: Color) -> Label:
	var label = Label.new()
	label.text = text_value
	label.add_theme_font_size_override("font_size", size)
	label.add_theme_color_override("font_color", color)
	return label

func _section(text_value: String) -> VBoxContainer:
	var box = VBoxContainer.new()
	box.add_theme_constant_override("separation", 4)
	box.add_child(_gap(5))
	box.add_child(_label(text_value, 11, ACCENT))
	var line = ColorRect.new()
	line.custom_minimum_size.y = 1
	line.color = Color(1, 1, 1, 0.10)
	box.add_child(line)
	return box

func _gap(height: float) -> Control:
	var gap = Control.new()
	gap.custom_minimum_size.y = height
	return gap

func _master_volume_text() -> String:
	return "MASTER SES  ·  %d%%" % int(round(master_volume * 100.0))

func _ui_sfx_text() -> String:
	return "MENÜ SES SEVİYESİ  ·  %d%%" % int(round(ui_sfx_volume * 100.0))

func _look_sensitivity_text() -> String:
	return "BAKIŞ HASSASİYETİ  ·  %d%%" % int(round(look_sensitivity * 100.0))

func _is_portrait() -> bool:
	var size = get_viewport().get_visible_rect().size
	return size.y > size.x

func _button_style(background: Color, edge: Color) -> StyleBoxFlat:
	var style = StyleBoxFlat.new()
	style.bg_color = background
	style.corner_radius_top_left = 5
	style.corner_radius_top_right = 5
	style.corner_radius_bottom_left = 5
	style.corner_radius_bottom_right = 5
	style.border_width_left = 1
	style.border_color = edge
	style.content_margin_left = 15.0
	style.content_margin_right = 12.0
	style.content_margin_top = 9.0
	style.content_margin_bottom = 9.0
	return style

func _panel_style(background: Color, radius: int, border: Color) -> StyleBoxFlat:
	var style = StyleBoxFlat.new()
	style.bg_color = background
	style.corner_radius_top_left = radius
	style.corner_radius_top_right = radius
	style.corner_radius_bottom_left = radius
	style.corner_radius_bottom_right = radius
	style.border_width_left = 1
	style.border_width_top = 1
	style.border_width_right = 1
	style.border_width_bottom = 1
	style.border_color = border
	return style

func _input(event: InputEvent) -> void:
	if not _is_back_event(event):
		return
	if _handle_back():
		get_viewport().set_input_as_handled()

func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_GO_BACK_REQUEST:
		_handle_back()

func _is_back_event(event: InputEvent) -> bool:
	if event.is_action_pressed("ui_cancel"):
		return true
	if event is InputEventKey and event.pressed:
		return event.keycode == KEY_ESCAPE
	return false

func _handle_back() -> bool:
	if dialog_overlay != null:
		_close_dialog_overlay()
		return true
	if advanced_overlay != null:
		_close_advanced_overlay()
		return true
	if menu_root == null:
		return false
	var current_state = int(menu_root.get("state"))
	if current_state == STATE_PLAYING:
		_pause_game()
		return true
	if current_state == STATE_PAUSED:
		_resume_game()
		return true
	if current_state in [STATE_MULTIPLAYER, STATE_CHARACTER, STATE_WORLD_SELECT, STATE_SETTINGS]:
		menu_root.call("_set_state", STATE_MAIN_MENU)
		_play_player(back_player, 0.72)
		return true
	if current_state in [STATE_MAIN_MENU, STATE_INTRO]:
		_confirm_quit()
		return true
	return current_state == STATE_TRANSITION
