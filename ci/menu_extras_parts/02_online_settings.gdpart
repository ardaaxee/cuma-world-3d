	var box = _find_box_with_label(safe, "ANA MENÜ")
	if box == null:
		return
	var marker = Control.new()
	marker.name = "CumaExtrasMarker"
	marker.custom_minimum_size.y = 3
	box.add_child(marker)
	var exit = _button("OYUNDAN ÇIK", false)
	exit.name = "CumaExitButton"
	exit.pressed.connect(_confirm_quit)
	box.add_child(exit)
	var version = _label("CINEMATIC MENU 1.0 · GODOT 4 · ANDROID", 10, Color(MUTED, 0.72))
	box.add_child(version)

func _decorate_multiplayer(safe: Control) -> void:
	var box = _find_box_with_label(safe, "ÇOK OYUNCULU")
	if box == null:
		return
	var marker = Control.new()
	marker.name = "CumaExtrasMarker"
	marker.custom_minimum_size.y = 3
	var back_button = _find_button_with_text(box, "GERİ")
	box.add_child(marker)
	var internet = _button("İNTERNET / RELAY", false)
	internet.name = "CumaInternetButton"
	internet.pressed.connect(_open_online_join)
	box.add_child(internet)
	if back_button != null:
		box.move_child(marker, back_button.get_index())
		box.move_child(internet, back_button.get_index())

func _open_online_join() -> void:
	if advanced_overlay != null:
		return
	advanced_overlay = CanvasLayer.new()
	advanced_overlay.name = "CumaOnlineJoinOverlay"
	advanced_overlay.layer = 190
	advanced_overlay.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(advanced_overlay)
	var dim = ColorRect.new()
	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	dim.color = Color(0.005, 0.007, 0.010, 0.76)
	advanced_overlay.add_child(dim)
	var panel = PanelContainer.new()
	panel.anchor_left = 0.06 if _is_portrait() else 0.50
	panel.anchor_right = 0.94
	panel.anchor_top = 0.10
	panel.anchor_bottom = 0.90
	panel.add_theme_stylebox_override("panel", _panel_style(PANEL, 10, Color(ACCENT, 0.30)))
	dim.add_child(panel)
	var margin = MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 22)
	margin.add_theme_constant_override("margin_right", 22)
	margin.add_theme_constant_override("margin_top", 22)
	margin.add_theme_constant_override("margin_bottom", 22)
	panel.add_child(margin)
	var box = VBoxContainer.new()
	box.add_theme_constant_override("separation", 8)
	margin.add_child(box)
	box.add_child(_label("ÇEVRİMİÇİ ODA", 30, TEXT))
	box.add_child(_label("Mevcut Cloudflare / WebSocket relay altyapısı", 12, MUTED))
	var code = _line_edit("6 haneli oda kodu")
	code.name = "CloudRoomCode"
	code.max_length = 6
	box.add_child(code)
	var cloud_join = _button("ODA KODUYLA KATIL", true)
	cloud_join.pressed.connect(_join_cloud_room.bind(code))
	box.add_child(cloud_join)
	box.add_child(_label("Gelişmiş relay bağlantısı", 11, ACCENT))
	var relay = _line_edit("wss:// relay adresi")
	relay.name = "RelayUrl"
	box.add_child(relay)
	var relay_code = _line_edit("6 haneli oda kodu")
	relay_code.max_length = 6
	box.add_child(relay_code)
	var relay_join = _button("RELAY İLE KATIL", false)
	relay_join.pressed.connect(_join_relay.bind(relay, relay_code))
	box.add_child(relay_join)
	var close = _button("KAPAT", false)
	close.pressed.connect(_close_advanced_overlay)
	box.add_child(close)
	code.grab_focus()

func _join_cloud_room(code_input: LineEdit) -> void:
	var net = get_node_or_null("/root/NetworkManager")
	if net == null or not net.has_method("join_cloud_room"):
		_show_notice("Cloud oda sistemi kullanılamıyor")
		return
	var err = int(net.call("join_cloud_room", code_input.text))
	if err != OK:
		_show_notice("Bağlantı başlatılamadı")
	else:
		_close_advanced_overlay()

func _join_relay(url_input: LineEdit, code_input: LineEdit) -> void:
	var net = get_node_or_null("/root/NetworkManager")
	if net == null or not net.has_method("join_relay"):
		_show_notice("Relay sistemi kullanılamıyor")
		return
	var err = int(net.call("join_relay", url_input.text, code_input.text))
	if err != OK:
		_show_notice("Relay bağlantısı başlatılamadı")
	else:
		_close_advanced_overlay()

func _close_advanced_overlay() -> void:
	if advanced_overlay != null:
		advanced_overlay.queue_free()
		advanced_overlay = null
	_play_player(back_player, 0.70)

func _build_settings_override(safe: Control) -> void:
	for child in safe.get_children():
		child.visible = false
	var marker = Control.new()
	marker.name = "CumaExtrasMarker"
	safe.add_child(marker)
	var panel = PanelContainer.new()
	panel.name = "CumaSettingsPanel"
	panel.anchor_left = 0.04 if _is_portrait() else 0.48
	panel.anchor_right = 0.96
	panel.anchor_top = 0.06
	panel.anchor_bottom = 0.94
	panel.add_theme_stylebox_override("panel", _panel_style(PANEL, 10, Color(ACCENT, 0.22)))
	safe.add_child(panel)
	var scroll = ScrollContainer.new()
	scroll.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	panel.add_child(scroll)
	var margin = MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 22)
	margin.add_theme_constant_override("margin_right", 22)
	margin.add_theme_constant_override("margin_top", 20)
	margin.add_theme_constant_override("margin_bottom", 20)
	margin.custom_minimum_size.x = 360
	scroll.add_child(margin)
	var box = VBoxContainer.new()
	box.add_theme_constant_override("separation", 9)
	margin.add_child(box)
	box.add_child(_label("CUMA WORLD", 12, MUTED))
	box.add_child(_label("AYARLAR", 32, TEXT))
	box.add_child(_label("Grafik · Ses · Kontroller · Erişilebilirlik", 12, MUTED))
	box.add_child(_section("GRAFİK"))
	var gs = get_node_or_null("/root/GameState")
	var profile = str(gs.get("quality_profile")) if gs != null else "MEDIUM"
	var quality = _button("KALİTE  ·  " + profile, true)
	quality.pressed.connect(_cycle_quality.bind(quality))
	box.add_child(quality)
	box.add_child(_section("SES"))
	var master_label = _label(_master_volume_text(), 12, TEXT)
	master_label.name = "MasterVolumeLabel"
	box.add_child(master_label)
	var master = HSlider.new()
	master.min_value = 0.0
	master.max_value = 100.0
	master.step = 1.0
	master.value = master_volume * 100.0
	master.custom_minimum_size.y = 38
	master.value_changed.connect(_on_master_volume_changed.bind(master_label))
	box.add_child(master)
	var sfx_toggle = _toggle("MENÜ SESLERİ", menu_sfx_enabled)
	sfx_toggle.toggled.connect(_on_menu_sfx_toggled)
	box.add_child(sfx_toggle)
	var ui_label = _label(_ui_sfx_text(), 12, TEXT)
	box.add_child(ui_label)
	var ui_volume = HSlider.new()
	ui_volume.min_value = 0.0
	ui_volume.max_value = 100.0
	ui_volume.step = 1.0
	ui_volume.value = ui_sfx_volume * 100.0
	ui_volume.custom_minimum_size.y = 38
	ui_volume.value_changed.connect(_on_ui_sfx_changed.bind(ui_label))
	box.add_child(ui_volume)
	box.add_child(_section("KONTROLLER"))
	var look_label = _label(_look_sensitivity_text(), 12, TEXT)
	box.add_child(look_label)
	var look = HSlider.new()
	look.min_value = 50.0
	look.max_value = 180.0
	look.step = 5.0
	look.value = look_sensitivity * 100.0
	look.custom_minimum_size.y = 38
	look.value_changed.connect(_on_look_sensitivity_changed.bind(look_label))
	box.add_child(look)
	var invert = _toggle("DİKEY BAKIŞI TERS ÇEVİR", invert_look_y)
	invert.toggled.connect(_on_invert_y_toggled)
	box.add_child(invert)
	box.add_child(_section("ERİŞİLEBİLİRLİK"))
	var motion = _toggle("AZALTILMIŞ HAREKET", reduced_motion)
	motion.toggled.connect(_on_reduced_motion_toggled)
	box.add_child(motion)
	if OS.has_feature("mobile"):
		var haptics = _toggle("DOKUNUŞ TİTREŞİMİ", haptics_enabled)
		haptics.toggled.connect(_on_haptics_toggled)
		box.add_child(haptics)
	var reset = _button("MENÜ TERCİHLERİNİ SIFIRLA", false)
	reset.pressed.connect(_reset_preferences)
	box.add_child(reset)
	var back = _button("GERİ", false)
	back.pressed.connect(_back_to_main_menu)
	box.add_child(back)
	quality.grab_focus()

func _build_settings_dialog(from_pause: bool) -> void:
	if dialog_overlay != null:
		return
	dialog_overlay = CanvasLayer.new()
	dialog_overlay.name = "CumaQuickSettings"
	dialog_overlay.layer = 240
	dialog_overlay.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(dialog_overlay)
	var dim = ColorRect.new()
	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	dim.color = Color(0.005, 0.007, 0.010, 0.82)
	dialog_overlay.add_child(dim)
	var panel = PanelContainer.new()
	panel.anchor_left = 0.08 if _is_portrait() else 0.54
	panel.anchor_right = 0.92 if _is_portrait() else 0.94
	panel.anchor_top = 0.16
	panel.anchor_bottom = 0.84
	panel.add_theme_stylebox_override("panel", _panel_style(PANEL, 10, Color(ACCENT, 0.30)))
	dim.add_child(panel)
	var margin = MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 22)
	margin.add_theme_constant_override("margin_right", 22)
	margin.add_theme_constant_override("margin_top", 20)
	margin.add_theme_constant_override("margin_bottom", 20)
	panel.add_child(margin)
	var box = VBoxContainer.new()
	box.add_theme_constant_override("separation", 9)
	margin.add_child(box)
